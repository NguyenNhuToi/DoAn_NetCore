@model List<QuanCafeWeb.ViewModels.CartItem>
@{
    ViewData["Title"] = "Thanh toán";
    var bans = ViewBag.Bans as List<QuanCafeWeb.Models.Ban> ?? new();
}

<h2>💳 Thanh toán</h2>

<form asp-action="Checkout" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Loại order:</label>
        <select name="loaiOrder" class="form-select">
            <option value="Tại chỗ">Tại chỗ</option>
            <option value="Mang đi">Mang đi</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Chọn bàn:</label>
        <select name="maBan" class="form-select">
            <option value="">-- Không chọn (Mang đi) --</option>
            @foreach (var ban in bans)
            {
                <option value="@ban.MaBan">@ban.TenBan - @ban.KhuVuc</option>
            }
        </select>
    </div>

    <table class="table">
        <thead><tr><th>Món</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TenMon</td>
                    <td>@item.SoLuong</td>
                    <td>@item.DonGia.ToString("N0")</td>
                    <td>@item.ThanhTien.ToString("N0")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><th colspan="3">TỔNG:</th><th>@Model.Sum(c => c.ThanhTien).ToString("N0") VNĐ</th></tr>
        </tfoot>
    </table>

    <button type="submit" class="btn btn-success">✅ Xác nhận thanh toán</button>
    <a asp-action="TaoOrder" class="btn btn-secondary">Quay lại</a>
</form>