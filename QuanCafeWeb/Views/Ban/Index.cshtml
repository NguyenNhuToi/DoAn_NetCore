@model X.PagedList.IPagedList<QuanCafeWeb.Models.Ban>
@using X.PagedList.Mvc.Core
@{ ViewData["Title"] = "Danh sách bàn"; }

<h2>🪑 Danh sách bàn</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="searchString" value="@ViewBag.SearchString"
               class="form-control" placeholder="Nhập tên bàn..." />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">🔍 Tìm</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
        <a asp-action="Create" class="btn btn-success">➕ Thêm bàn</a>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Mã bàn</th>
            <th>Tên bàn</th>
            <th>Khu vực</th>
            <th>Số ghế</th>
            <th>Trạng thái</th>
            <th width="150">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaBan</td>
                <td>@item.TenBan</td>
                <td>@item.KhuVuc</td>
                <td>@item.SoGhe</td>
                <td>@item.TrangThai</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MaBan" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.MaBan" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-center">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewBag.SearchString }))
</div>
