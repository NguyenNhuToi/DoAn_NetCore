@{
    ViewData["Title"] = "Báo cáo doanh thu";
}

<h2 class="mb-4">📊 Báo cáo doanh thu</h2>

<!-- ===== 4 THẺ DOANH THU ===== -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card text-white bg-success shadow">
            <div class="card-body">
                <h6>💰 Hôm nay</h6>
                <h3>@(((decimal)ViewBag.DoanhThuHomNay).ToString("N0")) đ</h3>
                <small>@ViewBag.DonHomNay đơn</small>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card text-white bg-primary shadow">
            <div class="card-body">
                <h6>📅 Tuần này</h6>
                <h3>@(((decimal)ViewBag.DoanhThuTuan).ToString("N0")) đ</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card text-white bg-warning shadow">
            <div class="card-body">
                <h6>🗓️ Tháng này</h6>
                <h3>@(((decimal)ViewBag.DoanhThuThang).ToString("N0")) đ</h3>
                <small>@ViewBag.DonThang đơn</small>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card text-white bg-info shadow">
            <div class="card-body">
                <h6>📆 Năm nay</h6>
                <h3>@(((decimal)ViewBag.DoanhThuNam).ToString("N0")) đ</h3>
                <small>Tổng: @ViewBag.TongDonHang đơn</small>
            </div>
        </div>
    </div>
</div>

<!-- ===== DOANH THU THEO LOẠI ===== -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <h6>🍽️ Doanh thu Tại chỗ</h6>
                <h3 class="text-primary">@(((decimal)ViewBag.DoanhThuTaiCho).ToString("N0")) đ</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <h6>🥡 Doanh thu Mang đi</h6>
                <h3 class="text-warning">@(((decimal)ViewBag.DoanhThuMangDi).ToString("N0")) đ</h3>
            </div>
        </div>
    </div>
</div>

<!-- ===== BIỂU ĐỒ DOANH THU 7 NGÀY ===== -->
<div class="card shadow mb-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">📈 Doanh thu 7 ngày gần nhất</h5>
    </div>
    <div class="card-body">
        <canvas id="chartDoanhThu" height="100"></canvas>
    </div>
</div>

<!-- ===== 2 BIỂU ĐỒ TOP ===== -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h5 class="mb-0">🏆 Top 5 món bán chạy</h5>
            </div>
            <div class="card-body">
                <canvas id="chartTopMon" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">🪑 Top 5 bàn doanh thu cao</h5>
            </div>
            <div class="card-body">
                <canvas id="chartTopBan" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ===== 1. BIỂU ĐỒ ĐƯỜNG - DOANH THU 7 NGÀY =====
        var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Labels));
        var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Data));

        new Chart(document.getElementById('chartDoanhThu'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: data,
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#3b82f6',
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: v => v.toLocaleString() + 'đ' }
                    }
                }
            }
        });

        // ===== 2. BIỂU ĐỒ TRÒN - TOP 5 MÓN =====
        var topMonLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopMonLabels));
        var topMonData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopMonData));

        new Chart(document.getElementById('chartTopMon'), {
            type: 'doughnut',
            data: {
                labels: topMonLabels,
                datasets: [{
                    data: topMonData,
                    backgroundColor: ['#a855f7', '#06b6d4', '#ec4899', '#fbbf24', '#10b981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // ===== 3. BIỂU ĐỒ CỘT - TOP 5 BÀN =====
        var topBanLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopBanLabels));
        var topBanData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopBanData));

        new Chart(document.getElementById('chartTopBan'), {
            type: 'bar',
            data: {
                labels: topBanLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: topBanData,
                    backgroundColor: '#3b82f6',
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: v => v.toLocaleString() + 'đ' }
                    }
                }
            }
        });
    </script>
}