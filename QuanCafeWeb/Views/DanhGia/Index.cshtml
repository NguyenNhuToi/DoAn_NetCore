@model IEnumerable<QuanCafeWeb.Models.DanhGia>

@{
    ViewData["Title"] = "Danh sách đánh giá";
    var danhSach = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>⭐ @ViewData["Title"]</h2>
    <a asp-controller="Home" asp-action="Menu" class="btn btn-primary">
        ☕ Đến Thực đơn để đánh giá
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!danhSach.Any())
{
    <div class="alert alert-info text-center py-4">
        <h5>🌱 Chưa có đánh giá nào</h5>
        <p class="mb-0">Hãy để khách hàng vào Thực đơn và đánh giá món ăn!</p>
    </div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th width="80">Mã</th>
                <th>Món</th>
                <th>Người đánh giá</th>
                <th width="120">Số sao</th>
                <th>Bình luận</th>
                <th width="160">Ngày</th>
                <th width="80">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in danhSach)
            {
                <tr>
                    <td>#@item.MaDanhGia</td>
                    <td><b>@item.Mon?.TenMon</b></td>
                    <td>@(string.IsNullOrEmpty(item.HoTen) ? "Ẩn danh" : item.HoTen)</td>
                    <td>
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= item.SoSao)
                            {
                                <span class="text-warning">★</span>
                            }
                            else
                            {
                                <span class="text-muted">☆</span>
                            }
                        }
                    </td>
                    <td>@item.BinhLuan</td>
                    <td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <form asp-action="Delete" method="post"
                              onsubmit="return confirm('Xóa đánh giá này?');">
                            <input type="hidden" name="id" value="@item.MaDanhGia" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}